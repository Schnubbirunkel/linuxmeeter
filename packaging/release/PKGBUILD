# Builds the checked-out source tree (used by .github/workflows/release.yml).
# For a git build from scratch see ../PKGBUILD.
pkgname=linuxmeeter
pkgver=0.2.0
pkgrel=1
pkgdesc="VoiceMeeter-style virtual audio mixer for PipeWire (Tauri + Svelte)"
arch=(x86_64)
url="https://github.com/Schnubbirunkel/linuxmeeter"
license=(GPL-3.0-or-later)
depends=(pipewire lsp-plugins-lv2 webkit2gtk-4.1 gtk3 libayatana-appindicator)
makedepends=(rust cargo nodejs pnpm pkgconf clang)
provides=(linuxmeeter)
conflicts=(linuxmeeter-git)
# See ../PKGBUILD: makepkg's LTO breaks libspa's C shim.
options=(!lto !debug)

_src() { realpath "$startdir/../.."; }

build() {
  cd "$(_src)"
  # pnpm 11 fails on unapproved build scripts; esbuild works without its own.
  pnpm install --frozen-lockfile --config.strict-dep-builds=false
  pnpm tauri build --no-bundle
}

package() {
  cd "$(_src)"
  install -Dm755 target/release/linuxmeeter "$pkgdir/usr/bin/linuxmeeter"
  install -Dm644 packaging/linuxmeeter.desktop "$pkgdir/usr/share/applications/linuxmeeter.desktop"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/linuxmeeter.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/linuxmeeter.png"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/linuxmeeter.png"
}
